{
	"name": "tgd",
	"private": true,
	"version": "0.1.14",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"tauri:build:mac": "tauri build --bundles app,dmg",
		"bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_typescript_bindings -- --nocapture",
		"server:dev": "cargo run --manifest-path src-tauri/Cargo.toml --bin tgd-server --no-default-features --features server",
		"docker:build": "sh docker/build.sh",
		"fpk:build": "sh docker/fpk/build.sh"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@tanstack/svelte-virtual": "^3.13.35",
		"@tauri-apps/api": "^2.11.1"
	}
}
