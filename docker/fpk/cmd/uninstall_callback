#!/bin/bash

# 默认保留数据。选删除才清共享目录和配置。
. "$(dirname "$0")/common.sh"

tgd_drop_legacy_docker

if [ "${wizard_data_action:-keep}" = "delete" ]; then
	rm -rf "${TRIM_PKGVAR}"
	rm -rf "/var/apps/${TRIM_APPNAME}/shares/tgd"
	rm -f "${TRIM_PKGETC}/telegram.env"
	rm -f "${TRIM_PKGETC}/runtime.env"
fi
exit 0
