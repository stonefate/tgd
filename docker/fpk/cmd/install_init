#!/bin/bash

# 应用中心会在 install_callback 之前 docker compose up。
# 必须先 load 离线镜像，否则会去拉 Docker Hub。
# 向导值在 install_init 可用（与飞牛官方 Docker 示例一致），写入 TRIM_PKGETC，compose 才能读到。
. "$(dirname "$0")/common.sh"

tgd_load_image
if [ -n "${wizard_telegram_api_id:-}" ] && [ -n "${wizard_telegram_api_hash:-}" ]; then
	tgd_write_env "${wizard_telegram_api_id}" "${wizard_telegram_api_hash}"
else
	tgd_touch_env
fi
tgd_ensure_runtime_env
tgd_write_compose_override
exit 0
